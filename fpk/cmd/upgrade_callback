#!/bin/bash
# upgrade_callback — invoked by fnOS AFTER an upgrade is applied.
# Restores permissions and brings the service back up, keeping the node identity.
set -u

APPNAME="${TRIM_APPNAME:-ztmesh}"
APPDEST="${TRIM_APPDEST:-/var/apps/${APPNAME}/target}"
PKGVAR="${TRIM_PKGVAR:-/var/apps/${APPNAME}/var}"
PKGTMP="${TRIM_PKGTMP:-/var/apps/${APPNAME}/tmp}"
# --- locate cmd/main ------------------------------------------------------
# fnOS passes TRIM_APPDEST as the *resolved* payload directory (e.g.
# /vol1/@appcenter/zerotier), whose parent is NOT the app root: the lifecycle
# scripts live under /var/apps/<appname>/. Deriving the path from "$APPDEST/.."
# yields /vol1/@appcenter/cmd/main and fails with exit 127.
find_main(){
  local c
  for c in "/var/apps/$APPNAME/cmd/main" \
           "${TRIM_PKGMETA:+$(dirname "$TRIM_PKGMETA")/cmd/main}" \
           "$(dirname "$APPDEST")/cmd/main" \
           "$APPDEST/cmd/main"; do
    [ -f "$c" ] && { echo "$c"; return 0; }
  done
  return 1
}
MAIN="$(find_main)" || MAIN=""
APPROOT="${MAIN%/cmd/main}"
[ -n "$APPROOT" ] || APPROOT="$(dirname "$APPDEST")"
LOG="${TRIM_TEMP_LOGFILE:-/tmp/${APPNAME}-upgrade.log}"
log(){ echo "[${APPNAME}/upgrade_callback] $*" >> "$LOG" 2>/dev/null; }

log "=== upgrade_callback start ==="

# --- 1. resolve this device's binaries and restore executable bits --------
# An upgrade may switch between the per-arch and the multi-arch ("all") layout,
# so the same resolution install_callback does has to run again here.
case "$(uname -m)" in
  x86_64|amd64)  GO_TAG="amd64"; ZT_TAG="x86_64" ;;
  aarch64|arm64) GO_TAG="arm64"; ZT_TAG="aarch64" ;;
  *)             GO_TAG=""; ZT_TAG="" ;;
esac

link_arch_binary(){
  local plain="$1" tag="$2" label="$3"
  [ -n "$tag" ] || return 0
  if [ -f "${plain}-${tag}" ]; then
    rm -f "$plain" 2>/dev/null
    if ln -sf "$(basename "${plain}-${tag}")" "$plain" 2>>"$LOG"; then
      log "$label: linked $plain -> $(basename "${plain}-${tag}")"
    else
      cp -f "${plain}-${tag}" "$plain" 2>>"$LOG" && log "$label: copied ${plain}-${tag}"
    fi
    chmod 0755 "${plain}-${tag}" 2>>"$LOG"
  fi
}

link_arch_binary "$APPDEST/bin/ztmesh-server" "$GO_TAG" "backend"
link_arch_binary "$APPDEST/zt/zerotier-one" "$ZT_TAG" "zerotier-one"

chmod 0755 "$APPDEST/zt/zerotier-one" 2>>"$LOG" || log "chmod zerotier-one failed"
chmod 0755 "$APPDEST/bin/ztmesh-server" 2>>"$LOG" || log "chmod ztmesh-server failed"
if [ -d "$APPROOT/cmd" ]; then
  chmod 0755 "$APPROOT"/cmd/* 2>>"$LOG" || log "chmod cmd/* failed"
fi

# --- 2. persistent state must survive the upgrade -------------------------
mkdir -p "$PKGVAR/zt" "$PKGTMP" 2>>"$LOG"
chmod 0700 "$PKGVAR/zt" 2>>"$LOG"
if [ -f "$PKGVAR/zt/identity.secret" ]; then
  log "node identity preserved"
else
  log "no existing identity; a new node address will be generated at start"
fi

# --- 3. record the new version --------------------------------------------
# install_callback writes $PKGVAR/VERSION, but an upgrade may go through
# upgrade_callback instead, which left the file (and anything displaying it)
# showing the old version.
if [ -f "$APPROOT/manifest" ]; then
  sed -n 's/^version=//p' "$APPROOT/manifest" > "$PKGVAR/VERSION" 2>>"$LOG"
  log "recorded version: $(cat "$PKGVAR/VERSION" 2>/dev/null)"
fi

# --- 4. refresh autostart --------------------------------------------------
# An upgrade keeps the registration, but re-applying it repairs a unit that an
# older version never created (or one that pointed at the removed node entry).
if [ -x "$MAIN" ]; then
  OUT="$("$MAIN" autostart-enable 2>&1)"
  log "autostart-enable rc=$? $OUT"
fi

# --- 5. restart ------------------------------------------------------------
if [ -x "$MAIN" ]; then
  "$MAIN" start >>"$LOG" 2>&1
  log "service start rc=$?"
else
  log "ERROR: $MAIN not executable; service not restarted"
fi

log "=== upgrade_callback ok ==="
exit 0
