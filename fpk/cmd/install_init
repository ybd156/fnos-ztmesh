#!/bin/bash
# install_init — invoked by fnOS BEFORE the package files are installed.
# Exit 0 to continue the installation, non-zero to abort it.
set -u

APPNAME="${TRIM_APPNAME:-ztmesh}"
LOG="${TRIM_TEMP_LOGFILE:-/tmp/${APPNAME}-install.log}"
log(){ echo "[${APPNAME}/install_init] $*" >> "$LOG" 2>/dev/null; }

log "=== install_init start ==="

# --- 1. architecture guard -------------------------------------------------
# The package ships an x86-64 or arm64 (aarch64) ZeroTier binary plus the
# matching Go management backend; anything else aborts.
ARCH="$(uname -m)"
log "uname -m = $ARCH"
case "$ARCH" in
  x86_64|amd64|aarch64|arm64) : ;;
  *)
    log "ERROR: unsupported architecture '$ARCH' (this package supports x86-64 or arm64 only)"
    echo "此安装包仅支持 x86-64 或 arm64 架构，当前设备为 $ARCH。"
    exit 1
    ;;
esac

# --- 2. tun driver --------------------------------------------------------
# ZeroTier creates a TUN interface; the device node must exist.
if [ ! -e /dev/net/tun ]; then
  log "/dev/net/tun is missing, attempting modprobe tun"
  if [ -d /dev/net ] || mkdir -p /dev/net 2>/dev/null; then
    modprobe tun >>"$LOG" 2>&1 || log "modprobe tun returned $?"
    [ -c /dev/net/tun ] || mknod /dev/net/tun c 10 200 >>"$LOG" 2>&1 || true
  fi
fi
if [ -c /dev/net/tun ]; then
  log "/dev/net/tun is available"
else
  log "WARNING: /dev/net/tun still unavailable; ZeroTier will fail to create interfaces"
fi

# --- 3. runtime requirements ---------------------------------------------
# The management backend is a static Go binary, so there is no nodejs/python
# runtime to look for. What the package does need is iptables (subnet routing)
# and either systemd or cron (autostart); both are reported, neither aborts the
# install because the core VPN works without them.
if command -v iptables >/dev/null 2>&1; then
  log "iptables: $(command -v iptables)"
else
  log "WARNING: iptables not found; 子网路由功能将不可用"
fi
if command -v systemctl >/dev/null 2>&1; then
  log "init: systemd available (autostart via unit)"
elif [ -d /etc/cron.d ]; then
  log "init: no systemd, autostart via /etc/cron.d"
else
  log "WARNING: neither systemd nor /etc/cron.d found; 开机自启需要手动配置"
fi

log "=== install_init ok ==="
exit 0
